# Copy this file to .env and fill in the value. The .env file is ignored by git; never commit a real key.

# Free API key from https://openrouter.ai (Keys). Without it the app still starts,
# but creating and adjusting plans answers "AI nuk është konfiguruar ende."
OPENROUTER_API_KEY=

# Models to try, in order, comma-separated. Optional. Every id must end in :free: there is no paid fallback.
# Free models come and go; look at the OpenRouter model list (filter: free) and edit this line when one disappears.
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free

# Accounts are off unless you ask. "memory" keeps them in memory, loses them on restart and writes mail
# to a local dev-mail/ folder instead of sending it: for trying the screens, never for real users.
# ACCOUNTS_MODE=memory
# The site's own address, used for links in e-mails and for the allowed origin. Default http://localhost:<PORT>.
# ORARI_BASE_URL=http://localhost:3000
# Memory mode only: skip the third-party leaked-password lookup (for offline development and automated runs).
# ACCOUNTS_PWNED_CHECK=off

# Port the server listens on. Optional; 3000 if left out.
PORT=3000

# Provider: openrouter (default, free models only) or groq (free tier, no card). Put the key for the one you use.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# ---- Real deployment: accounts in PostgreSQL (Neon, Supabase, ...) and mail over SMTP ----
# ACCOUNTS_MODE=postgres
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# SMTP_URL=smtps://user:password@smtp.provider.com:465
# 32+ random characters. Seals the links of queued e-mails inside the database.
# OUTBOX_SECRET=
# MAIL_FROM=Orari <no-reply@your-domain>
# The public https address of the site: links in e-mails and the allowed origin are built from it.
# ORARI_BASE_URL=https://orari.example
# Number of reverse proxies in front of this process (1 on Render, Railway, Fly). Needed for the client address
# and the https scheme of the origin check.
# TRUST_PROXY=1
