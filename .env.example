# Copy this file to .env and fill in the value. The .env file is ignored by git; never commit a real key.

# Free API key from https://openrouter.ai (Keys). Without it the app still starts,
# but creating and adjusting plans answers "AI nuk është konfiguruar ende."
OPENROUTER_API_KEY=

# Port the server listens on. Optional; 3000 if left out.
PORT=3000
